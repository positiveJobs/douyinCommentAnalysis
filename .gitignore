# ============================================================
#  评论观点智能分析 .gitignore
#  原则：只提交代码与配置，本地数据 / 模型 / 缓存 / 密钥一律不入库
#  以 / 开头的规则限定在仓库根目录，避免误伤同名目录
# ============================================================

# ---------------------------------------------------------------- 密钥与本地配置
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---------------------------------------------------------------- 本地数据（上传、中间结果、结果、报告、样例）
# data/ 下除说明文件外全部忽略：任务数据属于本地数据，不入库
/data/*
!/data/README.md

# ---------------------------------------------------------------- 模型与缓存（体积大，可重新下载 / 重新生成）
/models/
/cache/

# ---------------------------------------------------------------- Python 产物
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
wheels/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------- 虚拟环境
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------- 前端依赖与构建产物
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------- 数据库与中间产物
*.db
*.db-wal
*.db-shm
*.sqlite3
*.npz

# ---------------------------------------------------------------- 日志与临时文件
*.log
*.tmp
*.bak
_*.txt
~$*
*.swp

# ---------------------------------------------------------------- IDE / 编辑器
.idea/
.vscode/
*.iml
*.code-workspace

# ---------------------------------------------------------------- 操作系统
.DS_Store
Thumbs.db
desktop.ini
