# ============================================================
#  复制为 .env 后填入真实配置（.env 已被 .gitignore 忽略，不会入库）
#      Windows:  copy .env.example .env
#      macOS/Linux:  cp .env.example .env
# ============================================================

# ---- LLM：OpenAI 兼容的 Chat Completions 接口 ----
# BASE_URL 可以写完整的 /v1/chat/completions 地址，也可以只写到 /v1
BASE_URL=https://your-llm-endpoint/v1/chat/completions
API_KEY=sk-your-key-here
MODEL_NAME=your-model-name

# 兼容写法（上面的变量名优先）
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# ---- 本地 Embedding 模型（默认 models/bge-base-zh-v1.5，首次运行自动下载）----
# EMBEDDING_MODEL_DIR=
# EMBEDDING_DEVICE=auto           # auto / cpu / cuda / dml / coreml（auto 会实测后自动择优）
# EMBEDDING_AUTO_BENCHMARK=1      # 是否在 auto 模式下实测各后端速度

# ---- Web 服务可选参数 ----
# TASK_WORKERS=1                  # 同时执行的分析任务数（LLM 有限流，默认 1）
# MAX_UPLOAD_MB=100               # 上传文件大小上限
# TASK_QUEUE_SIZE=50              # 任务队列长度
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- LLM 效率参数（默认已针对限流做了平衡，可按需调整）----
# LLM_CONCURRENCY=8               # 并发请求数
# LLM_BATCH_SIZE=30               # 每批评论数（越大越省 token）
# LLM_BATCH_CHAR_BUDGET=6000      # 每批评论字符上限
# LLM_RATE_LIMIT_COOLDOWN=20      # 命中限流后的全局冷却秒数
